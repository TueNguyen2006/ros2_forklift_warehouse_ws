<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="forklift_inertials.xacro"/>

  <xacro:macro name="forklift_common_body" params="base_link:=base_link chassis_mass:=850.0 payload_mass:=0.0 enable_depth_camera:=true">
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="${base_link}"/>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
    </joint>

    <link name="${base_link}">
      <visual>
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <geometry><box size="1.65 1.05 0.50"/></geometry>
        <material name="green"><color rgba="0.1 0.8 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <geometry><box size="1.65 1.05 0.50"/></geometry>
      </collision>
      <xacro:inertial_box mass="${chassis_mass + payload_mass}" x="1.65" y="1.05" z="0.50">
        <origin xyz="-0.08 0 0.30" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <link name="mast_link">
      <visual>
        <origin xyz="0 0 0.9" rpy="0 0 0"/>
        <geometry><box size="0.16 1.0 1.8"/></geometry>
        <material name="red"><color rgba="0.9 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.9" rpy="0 0 0"/>
        <geometry><box size="0.16 1.0 1.8"/></geometry>
      </collision>
      <xacro:inertial_box mass="90.0" x="0.16" y="1.0" z="1.8">
        <origin xyz="0 0 0.9" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>
    <joint name="mast_joint" type="fixed">
      <parent link="${base_link}"/>
      <child link="mast_link"/>
      <origin xyz="0.78 0 0.42" rpy="0 0 0"/>
    </joint>

    <link name="fork_carriage_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.08 0.95 0.18"/></geometry>
        <material name="dark_gray"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><box size="0.08 0.95 0.18"/></geometry>
      </collision>
      <xacro:inertial_box mass="35.0" x="0.08" y="0.95" z="0.18">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>
    <joint name="fork_base_joint" type="prismatic">
      <parent link="mast_link"/>
      <child link="fork_carriage_link"/>
      <origin xyz="0.08 0 0.15" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.8" effort="1000.0" velocity="0.25"/>
      <dynamics damping="10.0" friction="1.0"/>
    </joint>

    <link name="left_fork_link">
      <visual><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><box size="1.0 0.08 0.05"/></geometry></visual>
      <collision><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><box size="1.0 0.08 0.05"/></geometry></collision>
      <xacro:inertial_box mass="18.0" x="1.0" y="0.08" z="0.05"><origin xyz="0.5 0 0" rpy="0 0 0"/></xacro:inertial_box>
    </link>
    <joint name="left_fork_joint" type="fixed">
      <parent link="fork_carriage_link"/>
      <child link="left_fork_link"/>
      <origin xyz="0.08 0.32 -0.10" rpy="0 0 0"/>
    </joint>

    <link name="right_fork_link">
      <visual><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><box size="1.0 0.08 0.05"/></geometry></visual>
      <collision><origin xyz="0.5 0 0" rpy="0 0 0"/><geometry><box size="1.0 0.08 0.05"/></geometry></collision>
      <xacro:inertial_box mass="18.0" x="1.0" y="0.08" z="0.05"><origin xyz="0.5 0 0" rpy="0 0 0"/></xacro:inertial_box>
    </link>
    <joint name="right_fork_joint" type="fixed">
      <parent link="fork_carriage_link"/>
      <child link="right_fork_link"/>
      <origin xyz="0.08 -0.32 -0.10" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame_link">
      <visual>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="white"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.01" length="0.04" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
    <joint name="laser_frame_joint" type="fixed">
      <parent link="${base_link}"/>
      <child link="laser_frame_link"/>
      <origin xyz="-0.35 0 0.62" rpy="0 0 0"/>
    </joint>
    <gazebo reference="laser_frame_link">
      <sensor name="laser" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>12.0</max>
          </range>
        </ray>
        <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros><argument>~/out:=scan</argument></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_frame_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <xacro:if value="${enable_depth_camera}">
      <link name="camera_link">
        <visual>
          <geometry><box size="0.03 0.04 0.04"/></geometry>
          <material name="white"><color rgba="1 1 1 1"/></material>
        </visual>
      </link>
      <joint name="camera_joint" type="fixed">
        <parent link="${base_link}"/>
        <child link="camera_link"/>
        <origin xyz="0.72 0 0.95" rpy="0 0 0"/>
      </joint>
      <link name="camera_link_optical"/>
      <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
      </joint>
      <gazebo reference="camera_link">
        <sensor name="camera" type="depth">
          <pose>0 0 0 0 0 0</pose>
          <visualize>false</visualize>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.089</horizontal_fov>
            <image>
              <format>B8G8R8</format>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.05</near>
              <far>8.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <frame_name>camera_link_optical</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>100.0</max_depth>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
