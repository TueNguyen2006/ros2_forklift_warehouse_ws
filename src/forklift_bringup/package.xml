<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forklift_bringup</name>
  <version>0.1.0</version>
  <description>Integrated launch entry points and shared run-mode configuration for the forklift warehouse stack.</description>
  <maintainer email="codex@example.com">Codex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>forklift_navigation</exec_depend>
  <exec_depend>forklift_safety</exec_depend>
  <exec_depend>forklift_simulation</exec_depend>
  <exec_depend>warehouse_visual_localization</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
